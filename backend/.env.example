# Modèle de configuration locale. npm run setup le copie en .env (non versionné)
# et y génère un JWT_SECRET aléatoire. Aucun secret réel ne doit figurer ici.
API_PORT=3000
DATABASE_PATH=data/gesta.db

# Clé de signature des jetons de session : générée par npm run setup.
JWT_SECRET=

# Mode démo : connexion sans mot de passe sous un utilisateur fictif.
# Réservé au développement local ; refusé si NODE_ENV=production.
DEMO_AUTH_ENABLED=true
